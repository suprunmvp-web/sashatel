[global]
type=global
endpoint_identifier_order=username

[lab-udp]
type=transport
protocol=udp
bind=@BIND_IPV4@:5060

[lab-endpoint](!)
type=endpoint
transport=lab-udp
identify_by=username
disallow=all
allow=alaw,ulaw
direct_media=no
media_address=@BIND_IPV4@
bind_rtp_to_media_address=yes
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
allow_transfer=no
allow_subscribe=no
trust_id_inbound=no
rtp_timeout=60
rtp_timeout_hold=120
deny=0.0.0.0/0

[1001](lab-endpoint)
context=from-1001
auth=auth-1001
aors=1001
callerid=Lab 1001 <1001>
permit=@PEER_1001@/32

[1002](lab-endpoint)
context=from-1002
auth=auth-1002
aors=1002
callerid=Lab 1002 <1002>
permit=@PEER_1002@/32

[1001]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

[1002]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

[auth-1001]
type=auth
auth_type=userpass
username=1001
password=@SECRET_1001@

[auth-1002]
type=auth
auth_type=userpass
username=1002
password=@SECRET_1002@

#tryinclude "/etc/sashatel-asterisk/uis-managed/bundles/active/pjsip.conf"
