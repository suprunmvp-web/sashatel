{
  "version": 2,
  "framework": null,
  "buildCommand": "node web/build.mjs",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://api.sashatel.ru/v1/:path*"
    },
    {
      "source": "/((?!assets/|version\\.json|v1/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "review/cabinet-parity-pr51": false,
      "review/internal-client-creation-web": false,
      "review/admin-organization-directory": false,
      "review/stale-session-login": false
    }
  }
}
