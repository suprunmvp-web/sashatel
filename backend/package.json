{
  "name": "sashatel-control-plane",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.ts",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module nodenext --target es2024 --allowImportingTsExtensions *.ts",
    "test": "node --test --test-concurrency=1 integration.test.ts web-auth.test.ts migration.test.ts server.test.ts ari-client.test.ts",
    "test:ari": "node --test ari-client.test.ts"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.31",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
