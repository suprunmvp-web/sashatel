# Provision the runtime URL externally. Use node --env-file only for local development.
DATABASE_URL=postgresql://control_runtime@127.0.0.1:5432/control
CALL_DAY_TIMEZONE=Europe/Moscow
PORT=8080
# Comma-separated test tenant IDs, explicitly enables local fake transport.
FAKE_ARI_TENANTS=
# Inject real values from your secret manager. Exact comma-separated DNS:port pairs.
UIS_VAULT_KEY_HEX=
UIS_REGISTRARS=
